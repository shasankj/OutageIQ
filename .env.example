# Copy to .env (git-ignored) and fill in. Never commit real values.
PGHOST=kenzo-coaching.cj6yseus2qi8.us-east-2.rds.amazonaws.com
PGPORT=5432
PGDATABASE=outageiq
PGSSLMODE=require

# One credential pair per role. Each script/app uses only its own.
OUTAGEIQ_OWNER_USER=outageiq_owner          # migrations + data generator
OUTAGEIQ_OWNER_PASSWORD=
OUTAGEIQ_INDEXER_USER=outageiq_indexer      # writes embeddings (rag schema)
OUTAGEIQ_INDEXER_PASSWORD=
OUTAGEIQ_READER_USER=outageiq_reader        # agent / retriever / MCP (SELECT only)
OUTAGEIQ_READER_PASSWORD=
# The colleague's role is NOT stored here; give him his own credentials directly.
